{
  "name": "world-card-station",
  "productName": "World Card Station",
  "version": "1.0.0",
  "description": "World Card Station (世界站), an AI roleplay game card platform",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "cd src/tauri && tauri build",
    "dev": "cd src/tauri && tauri dev",
    "renderer:build": "vite build --config vite.config.mjs",
    "renderer:dev": "vite --config vite.config.mjs",
    "web:dev": "vite --config vite.config.mjs --mode web",
    "web:build": "vite build --config vite.config.mjs --mode web",
    "test:web:build": "node scripts/build-web-tests.mjs",
    "test:web:unit": "jest --runInBand --coverage=false test/web/unit",
    "test:web:integration": "npm run test:web:build && wdio run wdio.web.integration.conf.mjs",
    "test:web:e2e": "npm run test:web:build && wdio run wdio.web.conf.mjs",
    "test:web": "npm run test:web:unit && npm run test:web:integration && wdio run wdio.web.conf.mjs",
    "tauri": "cd src/tauri && tauri",
    "tauri:dev": "npm run dev",
    "tauri:build": "npm run build",
    "tauri:e2e:build": "cd src/tauri && tauri build --debug --no-bundle --features e2e --config tauri.e2e.conf.json",
    "test:tauri-e2e": "wdio run wdio.tauri.conf.mjs",
    "test:tauri": "npm run tauri:e2e:build && npm run test:tauri-e2e",
    "lint": "eslint . --ext .js,.jsx",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "test": "npm run test:js && npm run test:rust && npm run test:tauri",
    "test:js": "jest && npm run test:integration",
    "test:rust": "cargo test --manifest-path src/tauri/Cargo.toml",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "npm run test:tauri",
    "test:e2e-real-api": "wdio run wdio.tauri.real-api.conf.mjs",
    "game-card:export": "cargo run --quiet --manifest-path src/tauri/Cargo.toml --bin game-card-export --",
    "game-card:publish": "cargo run --quiet --manifest-path src/tauri/Cargo.toml --bin game-card-publish --",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "@wdio/native-utils": "2.5.0"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "@fontsource/roboto-mono": "^5.2.9",
    "@tauri-apps/api": "^2.11.1",
    "ajv": "^8.20.0",
    "dompurify": "^3.4.2",
    "marked": "^18.0.2",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wdio/cli": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/mocha-framework": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "babel-jest": "^29.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "lint-staged": "^16.4.0",
    "vite": "^7.3.1"
  }
}
