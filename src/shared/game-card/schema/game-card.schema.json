{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "https://world-card-station.local/schemas/game-card/v1/schema.json",
  "x-schema-version": "1.8.0",
  "title": "Game Card", "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "name", "rules"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "stateSchema": { "$ref": "#/definitions/jsonFile" },
    "files": { "$ref": "#/definitions/textFiles" },
    "state": { "type": "object" },
    "audio": { "$ref": "#/definitions/audio" }, "visual": { "$ref": "#/definitions/visual" },
    "presentation": { "$ref": "#/definitions/presentation" }, "rules": { "type": "array", "items": { "$ref": "#/definitions/rule" } },
    "responseValidation": { "$ref": "#/definitions/responseValidation" }, "display": { "$ref": "#/definitions/display" }, "ui": { "$ref": "#/definitions/ui" }
  },
  "definitions": {
    "audio": { "type": "object", "additionalProperties": false, "properties": { "bgm": { "$ref": "#/definitions/audioMap" } } }, "presentation": { "type": "object", "additionalProperties": false, "properties": { "autoUpdateOnFirstToken": { "type": "boolean" } } },
    "audioMap": { "type": "object", "additionalProperties": { "$ref": "#/definitions/audioFile" } }, "textFiles": { "type": "object", "additionalProperties": { "$ref": "#/definitions/textFile" } },
    "visual": { "type": "object", "additionalProperties": false, "properties": { "stylesheet": { "$ref": "#/definitions/styleFile" }, "background": { "$ref": "#/definitions/imageMap" }, "cg": { "$ref": "#/definitions/imageMap" }, "portrait": { "$ref": "#/definitions/portraitMap" } } },
    "imageMap": { "type": "object", "additionalProperties": { "$ref": "#/definitions/imageFile" } },
    "portraitMap": { "type": "object", "propertyNames": { "not": { "const": "none" } }, "additionalProperties": { "$ref": "#/definitions/portraitExpressions" } }, "portraitExpressions": { "type": "object", "minProperties": 1, "propertyNames": { "not": { "const": "none" } }, "additionalProperties": { "$ref": "#/definitions/imageFile" } },
    "ui": { "type": "object", "additionalProperties": false, "properties": { "stylesheet": { "$ref": "#/definitions/styleFile" }, "root": { "$ref": "#/definitions/uiRoot" }, "scripts": { "type": "object", "additionalProperties": { "anyOf": [{ "$ref": "#/definitions/scriptFile" }, { "type": "object", "additionalProperties": false, "required": ["sourceFile"], "properties": { "sourceFile": { "$ref": "#/definitions/scriptFile" } } }] } } } },
    "uiRoot": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "type": { "const": "react" }, "source": { "$ref": "#/definitions/reactSourceFile" }, "style": { "$ref": "#/definitions/styleFile" }, "props": { "type": "object" } } },
    "display": { "type": "object", "additionalProperties": false, "properties": { "stylesheet": { "$ref": "#/definitions/styleFile" }, "segmentedReading": { "type": "boolean" }, "segmentSeparator": { "type": "string", "minLength": 1, "maxLength": 64 }, "assistant": { "$ref": "#/definitions/displayRules" }, "user": { "$ref": "#/definitions/displayRules" } } }, "displayRules": { "type": "array", "items": { "$ref": "#/definitions/displayRule" } },
    "safeFile": { "type": "string", "pattern": "^(?![/\\\\])(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$", "x-file": true },
    "jsonFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.json$" }] },
    "textFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.(md|txt|json)$" }] },
    "styleFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.css$" }] },
    "scriptFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.js$" }] },
    "reactSourceFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.jsx?$" }] },
    "audioFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.(mp3|ogg|wav|m4a)$" }] },
    "imageFile": { "allOf": [{ "$ref": "#/definitions/safeFile" }, { "pattern": "\\.(png|jpg|jpeg|webp|gif|bmp)$" }] },
    "displayRule": { "type": "object", "additionalProperties": false, "required": ["stage", "type", "pattern"], "properties": { "id": { "type": "string", "minLength": 1 }, "enabled": { "type": "boolean" }, "stage": { "const": "before_markdown" }, "type": { "const": "regex_replace" }, "pattern": { "type": "string", "maxLength": 1000 }, "flags": { "type": "string", "pattern": "^[gimsu]*$" }, "replace": { "type": "string" } } },
    "responseValidation": { "type": "object", "additionalProperties": false, "required": ["rules"], "properties": { "onFailure": { "enum": ["retry", "warn"] }, "maxRetries": { "type": "integer", "minimum": 0, "maximum": 5 }, "rules": { "type": "array", "maxItems": 64, "items": { "$ref": "#/definitions/responseValidationRule" } } } }, "responseValidationRule": { "oneOf": [{ "$ref": "#/definitions/responseRegexRule" }, { "$ref": "#/definitions/responseStateRule" }] },
    "responseRegexRule": { "type": "object", "additionalProperties": false, "required": ["id", "type", "pattern", "matches", "message"], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "enabled": { "type": "boolean" }, "when": { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "$ref": "#/definitions/statePredicate" } } }, "type": { "const": "content.regex" }, "onFailure": { "enum": ["retry", "warn"] }, "message": { "type": "string", "minLength": 1, "maxLength": 1000 }, "source": { "enum": ["content", "raw"] }, "pattern": { "type": "string", "maxLength": 2048 }, "flags": { "type": "string", "pattern": "^[imsu]*$" }, "matches": { "$ref": "#/definitions/comparison" } } }, "responseStateRule": { "type": "object", "additionalProperties": false, "required": ["id", "type", "path", "message"], "anyOf": [{ "required": ["updates"] }, { "required": ["operations"] }, { "required": ["value"] }, { "required": ["delta"] }], "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "enabled": { "type": "boolean" }, "when": { "type": "object", "additionalProperties": false, "required": ["state"], "properties": { "state": { "$ref": "#/definitions/statePredicate" } } }, "type": { "const": "state.update" }, "onFailure": { "enum": ["retry", "warn"] }, "message": { "type": "string", "minLength": 1, "maxLength": 1000 }, "path": { "$ref": "#/definitions/statePath" }, "updates": { "$ref": "#/definitions/comparison" }, "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["state.set", "state.inc", "state.append", "state.remove", "state.delete", "state.advance", "state.roll", "state.randomInt"] } }, "value": { "$ref": "#/definitions/stateMatcher" }, "delta": { "$ref": "#/definitions/numericMatcher" } } }, "numericMatcher": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "eq": { "type": "number" }, "gt": { "type": "number" }, "gte": { "type": "number" }, "lt": { "type": "number" }, "lte": { "type": "number" } } },
    "rule": { "type": "object", "additionalProperties": false, "required": ["when", "then"], "properties": { "id": { "type": "string", "minLength": 1 }, "when": { "$ref": "#/definitions/when" }, "find": { "$ref": "#/definitions/find" }, "then": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/action" } } } },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": { "enum": ["init", "pre_send", "after_stream", "after_response"] },
        "length": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/definitions/comparison" }] },
        "last": { "$ref": "#/definitions/lastPredicate" },
        "any": { "$ref": "#/definitions/predicate" },
        "all": { "$ref": "#/definitions/predicate" },
        "state": { "$ref": "#/definitions/statePredicate" }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gt": { "type": "integer", "minimum": 0 },
        "gte": { "type": "integer", "minimum": 0 },
        "lt": { "type": "integer", "minimum": 0 },
        "lte": { "type": "integer", "minimum": 0 },
        "eq": { "type": "integer", "minimum": 0 }
      }
    },
    "action": {
      "type": "object",
      "if": { "required": ["type"] },
      "then": { "allOf": [
          { "properties": { "type": { "enum": ["insert", "remove", "replace", "exec", "state.set", "state.inc", "state.append", "state.remove", "state.delete", "state.advance", "state.roll", "state.randomInt", "visual.updateBackground", "visual.updatePortrait", "audio.updateBgm"] } } },
          { "if": { "properties": { "type": { "const": "insert" } } }, "then": { "$ref": "#/definitions/insertAction" } },
          { "if": { "properties": { "type": { "const": "remove" } } }, "then": { "$ref": "#/definitions/removeAction" } },
          { "if": { "properties": { "type": { "const": "replace" } } }, "then": { "$ref": "#/definitions/replaceAction" } },
          { "if": { "properties": { "type": { "const": "exec" } } }, "then": { "$ref": "#/definitions/execAction" } },
          { "if": { "properties": { "type": { "enum": ["state.set", "state.append", "state.remove"] } } }, "then": { "$ref": "#/definitions/stateValueAction" } }, { "if": { "properties": { "type": { "const": "state.inc" } } }, "then": { "$ref": "#/definitions/stateIncrementAction" } },
          { "if": { "properties": { "type": { "enum": ["state.delete", "state.advance"] } } }, "then": { "$ref": "#/definitions/stateDeleteAction" } },
          { "if": { "properties": { "type": { "const": "state.roll" } } }, "then": { "$ref": "#/definitions/stateRollAction" } },
          { "if": { "properties": { "type": { "const": "state.randomInt" } } }, "then": { "$ref": "#/definitions/stateRandomIntAction" } },
          { "if": { "properties": { "type": { "enum": ["visual.updateBackground", "visual.updatePortrait"] } } }, "then": { "$ref": "#/definitions/presentationVisualAction" } },
          { "if": { "properties": { "type": { "const": "audio.updateBgm" } } }, "then": { "$ref": "#/definitions/presentationBgmAction" } }
      ] },
      "else": { "$ref": "#/definitions/actionGroup" }
    },
    "insertAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "role", "content"],
      "properties": {
        "type": { "const": "insert" },
        "when": { "$ref": "#/definitions/contentWhen" },
        "predicate": { "$ref": "#/definitions/predicate" },
        "anchor": { "enum": ["before", "after"] },
        "role": { "$ref": "#/definitions/messageRole" },
        "content": { "$ref": "#/definitions/content" },
        "find": { "$ref": "#/definitions/find" },
        "ttl": { "$ref": "#/definitions/ttl" },
        "_meta": { "$ref": "#/definitions/messageMeta" }
      }
    },
    "removeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "predicate"],
      "properties": {
        "type": { "const": "remove" },
        "when": { "$ref": "#/definitions/contentWhen" },
        "predicate": { "$ref": "#/definitions/predicate" }
      }
    },
    "replaceAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "predicate"],
      "anyOf": [{ "required": ["content"] }, { "required": ["ttl"] }],
      "properties": {
        "type": { "const": "replace" },
        "when": { "$ref": "#/definitions/contentWhen" },
        "predicate": { "$ref": "#/definitions/predicate" },
        "content": { "$ref": "#/definitions/content" },
        "find": { "$ref": "#/definitions/find" },
        "ttl": { "$ref": "#/definitions/ttl" },
        "_meta": { "$ref": "#/definitions/messageMeta" }
      }
    },
    "execAction": { "type": "object", "additionalProperties": false, "required": ["type"], "oneOf": [{ "required": ["source"] }, { "required": ["sourceFile"] }], "properties": { "type": { "const": "exec" }, "when": { "$ref": "#/definitions/contentWhen" }, "source": { "type": "string", "minLength": 1 }, "sourceFile": { "$ref": "#/definitions/scriptFile" } } },
    "presentationVisualAction": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "enum": ["visual.updateBackground", "visual.updatePortrait"] }, "when": { "$ref": "#/definitions/contentWhen" } } }, "presentationBgmAction": { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "audio.updateBgm" }, "when": { "$ref": "#/definitions/contentWhen" } } },
    "statePath": { "type": "string", "pattern": "^[^.[\\]]+(\\.[^.[\\]]+)*$" },
    "jsonValue": { "anyOf": [{ "type": ["string", "number", "boolean", "null"] }, { "type": "array", "items": { "$ref": "#/definitions/jsonValue" } }, { "type": "object", "additionalProperties": { "$ref": "#/definitions/jsonValue" } }] },
    "stateValueAction": { "type": "object", "additionalProperties": false, "required": ["type", "path", "value"], "properties": { "type": { "enum": ["state.set", "state.append", "state.remove"] }, "when": { "$ref": "#/definitions/contentWhen" }, "path": { "$ref": "#/definitions/statePath" }, "value": { "$ref": "#/definitions/jsonValue" } } }, "stateIncrementAction": { "type": "object", "additionalProperties": false, "required": ["type", "path", "value"], "properties": { "type": { "const": "state.inc" }, "when": { "$ref": "#/definitions/contentWhen" }, "path": { "$ref": "#/definitions/statePath" }, "value": { "type": "number" } } },
    "stateDeleteAction": { "type": "object", "additionalProperties": false, "required": ["type", "path"], "properties": { "type": { "enum": ["state.delete", "state.advance"] }, "when": { "$ref": "#/definitions/contentWhen" }, "path": { "$ref": "#/definitions/statePath" } } },
    "stateRollAction": { "type": "object", "additionalProperties": false, "required": ["type", "path", "dice"], "properties": { "type": { "const": "state.roll" }, "when": { "$ref": "#/definitions/contentWhen" }, "path": { "$ref": "#/definitions/statePath" }, "dice": { "type": "string", "pattern": "^([1-9]\\d*)?d([1-9]\\d*)$" } } },
    "stateRandomIntAction": { "type": "object", "additionalProperties": false, "required": ["type", "path", "min", "max"], "properties": { "type": { "const": "state.randomInt" }, "when": { "$ref": "#/definitions/contentWhen" }, "path": { "$ref": "#/definitions/statePath" }, "min": { "type": "integer" }, "max": { "type": "integer", "minimum": { "$data": "1/min" } } } }, "actionGroup": { "type": "object", "additionalProperties": false, "required": ["when", "then"], "properties": { "when": { "$ref": "#/definitions/contentWhen" }, "find": { "$ref": "#/definitions/find" }, "then": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/action" } } } },
    "find": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/findItem" } },
    "findItem": { "type": "object", "additionalProperties": false, "required": ["name", "from"], "properties": { "name": { "type": "string", "minLength": 1 }, "from": { "$ref": "#/definitions/predicate" }, "select": { "enum": ["content", "thinking", "role", "_meta.source"] }, "match": { "$ref": "#/definitions/findMatch" }, "many": { "type": "boolean" }, "join": { "type": "string" }, "default": { "$ref": "#/definitions/jsonValue" } } },
    "findMatch": { "type": "object", "additionalProperties": false, "required": ["regex"], "properties": { "regex": { "type": "string", "minLength": 1 }, "group": { "type": "integer", "minimum": 0 } } },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "role": { "anyOf": [{ "$ref": "#/definitions/messageRole" }, { "$ref": "#/definitions/stringSetMatcher" }] },
        "content": { "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/stringMatcher" }] },
        "thinking": { "$ref": "#/definitions/stringMatcher" },
        "_meta.source": { "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/stringMatcher" }] },
        "index": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "last" }] },
        "occurrence": { "enum": ["last", "not_last"] },
        "all": { "const": true },
        "or": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/predicate" }
        },
        "not": { "$ref": "#/definitions/predicate" }
      }
    },
    "lastPredicate": {
      "anyOf": [
        { "$ref": "#/definitions/predicate" },
        { "type": "object", "additionalProperties": false, "minProperties": 2, "required": ["num"], "properties": { "num": { "type": "integer", "minimum": 1 }, "role": { "anyOf": [{ "$ref": "#/definitions/messageRole" }, { "$ref": "#/definitions/stringSetMatcher" }] }, "content": { "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/stringMatcher" }] }, "thinking": { "$ref": "#/definitions/stringMatcher" }, "_meta.source": { "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/stringMatcher" }] }, "index": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "const": "last" }] }, "occurrence": { "enum": ["last", "not_last"] }, "all": { "const": true }, "or": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/predicate" } }, "not": { "$ref": "#/definitions/predicate" } } }
      ]
    },
    "stringMatcher": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "contains": { "type": "string" },
        "regex": { "type": "string", "minLength": 1 },
        "in": { "$ref": "#/definitions/stringList" },
        "nin": { "$ref": "#/definitions/stringList" }
      }
    },
    "stringSetMatcher": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "in": { "$ref": "#/definitions/stringList" }, "nin": { "$ref": "#/definitions/stringList" } } },
    "stringList": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "statePredicate": { "type": "object", "additionalProperties": { "anyOf": [{ "type": ["string", "number", "boolean", "null"] }, { "$ref": "#/definitions/stateMatcher" }] }, "minProperties": 1 },
    "stateMatcher": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "eq": {}, "gt": { "type": ["number", "string"] }, "gte": { "type": ["number", "string"] }, "lt": { "type": ["number", "string"] }, "lte": { "type": ["number", "string"] }, "in": { "type": "array", "minItems": 1 }, "nin": { "type": "array", "minItems": 1 }, "contains": {}, "exists": { "type": "boolean" }, "regex": { "type": "string" } } },
    "content": { "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/contentInclude" }, { "$ref": "#/definitions/contentSelect" }] }, "contentInclude": { "type": "object", "additionalProperties": false, "required": ["include"], "properties": { "include": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/contentBranch" } }, "default": { "$ref": "#/definitions/content" }, "join": { "type": "string" }, "prefix": { "$ref": "#/definitions/content" }, "suffix": { "$ref": "#/definitions/content" } } }, "contentSelect": { "type": "object", "additionalProperties": false, "required": ["select"], "properties": { "select": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/contentBranch" } }, "default": { "$ref": "#/definitions/content" }, "prefix": { "$ref": "#/definitions/content" }, "suffix": { "$ref": "#/definitions/content" } } }, "contentBranch": { "type": "object", "additionalProperties": false, "required": ["content"], "properties": { "when": { "$ref": "#/definitions/contentWhen" }, "content": { "$ref": "#/definitions/content" } } }, "contentWhen": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "phase": { "enum": ["init", "pre_send", "after_stream", "after_response"] }, "length": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/definitions/comparison" }] }, "last": { "$ref": "#/definitions/lastPredicate" }, "any": { "$ref": "#/definitions/predicate" }, "all": { "$ref": "#/definitions/predicate" }, "state": { "$ref": "#/definitions/statePredicate" } } },
    "messageRole": { "enum": ["user", "assistant", "system"] },
    "ttl": { "type": "integer", "minimum": -1 },
    "messageMeta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string" },
        "visibility": { "enum": ["llm_only", "user_visible", "debug_only"] }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "$ref": "#/definitions/messageRole" },
        "content": { "type": "string" },
        "thinking": { "type": "string" },
        "_meta": { "$ref": "#/definitions/messageMeta" },
        "ttl": { "$ref": "#/definitions/ttl" }
      } }
  }
}
