{
  "build": {
    "beforeBuildCommand": "npm --prefix .. run renderer:build -- --mode tauri-e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Test-only WebdriverIO permissions for the main window",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:allow-destroy",
            "core:window:default",
            "core:window:allow-set-focus",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
