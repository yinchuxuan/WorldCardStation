{
  "version": "1.0",
  "id": "worldbook-library-example",
  "name": "Worldbook Library Example",
  "files": {
    "worldbook": {
      "directory": "worldbook",
      "include": ["config.json", "entries/*.md"]
    }
  },
  "rules": [{
    "id": "worldbook",
    "when": { "phase": "pre_send", "any": { "role": "user" } },
    "then": [{
      "type": "exec",
      "sourceFile": "lib/worldbook/index.js",
      "args": { "worldbook": "worldbook" }
    }]
  }]
}
