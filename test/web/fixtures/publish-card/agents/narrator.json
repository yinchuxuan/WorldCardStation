{
  "model": "default",
  "rules": [
    { "$import": "rules/init.json" },
    { "when": { "phase": "pre_send" }, "then": [
      { "type": "insert", "role": "user", "content": "{{state:input}}" },
      { "type": "state.inc", "path": "count", "value": 1 }
    ] },
    { "when": { "phase": "post_response" }, "then": [
      { "type": "state.set", "path": "visual.scene", "value": "outside" },
      { "type": "state.set", "path": "visual.portraits", "value": { "guide": "smile" } },
      { "type": "visual.updateBackground" }, { "type": "audio.updateBgm" }
    ] }
  ]
}
